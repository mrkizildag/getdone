# From your Notion integration's OAuth settings.
NOTION_CLIENT_ID=00000000-0000-0000-0000-000000000000
NOTION_CLIENT_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public HTTPS origin this service is reachable at. The callback registered
# with Notion is this plus /api/code.
PUBLIC_BASE_URL=https://oauth.example.com

# Bind address. Keep on loopback and let the reverse proxy terminate TLS.
HOST=127.0.0.1
PORT=8787
