# The extension deliberately stays on the toolchain Raycast pinned for
# @raycast/api 1.48.5 (@types/node ~16, TypeScript 4.x). Vitest declares a
# peerOptional on @types/node >=18, which is a types-only hint with no runtime
# effect on the test runner. Bumping @types/node instead cascades into a
# TypeScript upgrade, since TS 4.6 cannot parse modern @types/node.
legacy-peer-deps=true
